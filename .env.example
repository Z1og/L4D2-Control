# Node.js 20.6+ supports: node --env-file=.env server.js
PORT=4174
BIND_HOST=127.0.0.1
L4D2_EXEC_MODE=local
L4D2_SERVER_ROOT=/srv/l4d2
L4D2_SCREEN_SESSION=l4d2
# Public game hostname/IP (no protocol). Empty disables the copy button.
L4D2_GAME_HOST=
L4D2_GAME_PORT=27015
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_AUTH_TOKEN=
# Required only for remote SSH mode
L4D2_SSH_HOST=
L4D2_SSH_PORT=22
L4D2_SSH_USER=
L4D2_SSH_PASSWORD=
# Optional existing certificate files
PANEL_TLS_KEY=
PANEL_TLS_CERT=
# Optional content proxy; only loopback SOCKS5h is supported
WORKSHOP_SOCKS_PROXY=
# Optional: configure a Mihomo/Xray daemon separately before enabling proxy features.
WORKSHOP_PROXY_ENGINE=
WORKSHOP_MIHOMO_HOME=
WORKSHOP_MIHOMO_BIN=
WORKSHOP_DASHBOARD_DIR=
STEAMCMD_PATH=/opt/steamcmd/steamcmd.sh
GAMEMAPS_BROWSER_BIN=
# LaoYutang L4D2 plugin store; server fetches GitHub catalog and compiled .smx files
PLUGIN_STORE_REFRESH_SECONDS=21600
PLUGIN_STORE_SYNC_ENABLED=true
PLUGIN_STORE_CACHE_DIR=
# Optional OpenList web address for sharing installed custom VPK maps.
# The OpenList storage must expose the same map folder at this public path.
OPENLIST_URL=
OPENLIST_SHARE_TOKEN=
OPENLIST_MAPS_PATH=/l4d2-maps
# When true, allow manual/automatic VPK backup from the in-console cloud view.
# The storage must be a writable cloud-drive driver; false only shares files already present there.
OPENLIST_UPLOAD=false

# Scoped service account alternative to OPENLIST_SHARE_TOKEN. Keep secrets server-side.
OPENLIST_USER=
OPENLIST_PASSWORD=
# Use / when the account base path is already /l4d2-maps.
OPENLIST_API_PATH=/l4d2-maps
# Optional private state path. Automatic backup is enabled in the console.
CLOUD_MAPS_STATE_DIR=

# Optional co-located HTTPS upload connection; only 127.0.0.1 or ::1.
# TLS still validates the hostname and certificate of OPENLIST_URL.
OPENLIST_CONNECT_ADDRESS=
